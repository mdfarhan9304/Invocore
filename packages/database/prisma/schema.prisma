generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core"]
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER

  @@schema("core")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  memberships   Membership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
  @@schema("core")
}

model Organization {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  currency               String                  @default("USD")
  memberships            Membership[]
  clients                Client[]
  products               Product[]
  invoices               Invoice[]
  invoiceNumberSequences InvoiceNumberSequence[]
  auditLogs              AuditLog[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@map("organizations")
  @@schema("core")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           Role
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
  @@schema("core")
}

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  taxId          String?      @map("tax_id")
  addressLine1   String?      @map("address_line1")
  addressLine2   String?      @map("address_line2")
  city           String?
  state          String?
  postalCode     String?      @map("postal_code")
  country        String?
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("clients")
  @@schema("core")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  name             String
  description      String?
  unitPrice        Int               @map("unit_price")
  currency         String            @default("USD")
  taxRate          Int               @default(0) @map("tax_rate")
  isActive         Boolean           @default(true) @map("is_active")
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceLineItems InvoiceLineItem[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("products")
  @@schema("core")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED

  @@schema("core")
}

enum InvoiceDocumentStatus {
  QUEUED
  PROCESSING
  READY
  FAILED

  @@schema("core")
}

enum PaymentLinkStatus {
  ACTIVE
  PARTIALLY_PAID
  PAID
  CANCELLED
  EXPIRED

  @@schema("core")
}

enum PaymentStatus {
  CAPTURED
  FAILED

  @@schema("core")
}

model Invoice {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  clientId       String            @map("client_id") @db.Uuid
  invoiceNumber  String?           @map("invoice_number")
  status         InvoiceStatus     @default(DRAFT)
  issueDate      DateTime?         @map("issue_date") @db.Date
  dueDate        DateTime?         @map("due_date") @db.Date
  currency       String            @default("INR")
  subtotal       Int               @default(0)
  taxTotal       Int               @default(0) @map("tax_total")
  total          Int               @default(0)
  amountPaid     Int               @default(0) @map("amount_paid")
  balanceDue     Int               @default(0) @map("balance_due")
  notes          String?
  terms          String?
  version        Int               @default(1)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lineItems      InvoiceLineItem[]
  documents      InvoiceDocument[]
  paymentLinks   PaymentLink[]
  payments       Payment[]
  createdAt      DateTime          @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@map("invoices")
  @@schema("core")
}

model InvoiceDocument {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  invoiceId      String                @map("invoice_id") @db.Uuid
  invoiceVersion Int                   @map("invoice_version")
  status         InvoiceDocumentStatus @default(QUEUED)
  storagePath    String?               @map("storage_path")
  errorMessage   String?               @map("error_message")
  invoice        Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  completedAt    DateTime?             @map("completed_at")

  @@unique([invoiceId, invoiceVersion])
  @@index([organizationId, status])
  @@map("invoice_documents")
  @@schema("core")
}

model PaymentLink {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  invoiceId      String            @map("invoice_id") @db.Uuid
  invoiceVersion Int               @map("invoice_version")
  provider       String            @default("RAZORPAY")
  providerLinkId String?           @unique @map("provider_link_id")
  paymentUrl     String?           @map("payment_url")
  amount         Int
  amountPaid     Int               @default(0) @map("amount_paid")
  currency       String
  status         PaymentLinkStatus @default(ACTIVE)
  idempotencyKey String            @unique @map("idempotency_key")
  expiresAt      DateTime?         @map("expires_at")
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payments       Payment[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([invoiceId, invoiceVersion])
  @@map("payment_links")
  @@schema("core")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  paymentLinkId     String?       @map("payment_link_id") @db.Uuid
  providerPaymentId String        @unique @map("provider_payment_id")
  webhookEventId    String        @unique @map("webhook_event_id")
  amount            Int
  currency          String
  status            PaymentStatus
  method            String?
  paidAt            DateTime?     @map("paid_at")
  providerCreatedAt DateTime?     @map("provider_created_at")
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentLink       PaymentLink?  @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@index([invoiceId, createdAt])
  @@map("payments")
  @@schema("core")
}

model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  description String
  quantity    Int
  unitPrice   Int      @map("unit_price")
  taxRate     Int      @default(0) @map("tax_rate")
  lineTotal   Int      @map("line_total")
  lineTax     Int      @map("line_tax")
  sortOrder   Int      @default(0) @map("sort_order")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@map("invoice_line_items")
  @@schema("core")
}

model InvoiceNumberSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  year           Int
  lastNumber     Int          @default(0) @map("last_number")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year])
  @@map("invoice_number_sequences")
  @@schema("core")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("core")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  action         String
  resource       String
  resourceId     String?       @map("resource_id")
  metadata       Json?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([userId])
  @@index([resource, resourceId])
  @@map("audit_logs")
  @@schema("core")
}
