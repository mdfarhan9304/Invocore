# Local development
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=invocore
POSTGRES_USER=invocore
POSTGRES_PASSWORD=invocore_dev_password
DATABASE_URL=postgresql://invocore:invocore_dev_password@127.0.0.1:5433/invocore?schema=core

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Razorpay
APP_URL=http://localhost:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local PDF storage
INVOICE_PDF_STORAGE_PATH=../../storage/invoices

# Auth
JWT_SECRET=replace_with_a_long_random_secret_for_local_development
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Service ports
CORE_API_PORT=3001
PAYMENTS_SERVICE_PORT=3002
WORKERS_SERVICE_PORT=3003
